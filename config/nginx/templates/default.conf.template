# PNeX TLS edge — single origin https://${PNEX_PUBLIC_HOST}.
# Rendered by the nginx image's envsubst step (only PNEX_* variables).

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Upstreams are resolved per request through Docker's DNS (variables in
# proxy_pass): nginx starts even while Rauthy / pnex-server are booting and
# follows a recreated container's new IP.
# Alias names (mDNS `<hostname>.local`) are redirected to the canonical
# origin: the OIDC client and session cookies only know PNEX_DOMAIN.
map $host $pnex_alias {
    default 0;
    "${PNEX_DOMAIN_ALIAS}" 1;
}

resolver 127.0.0.11 valid=10s ipv6=off;

# Quiet by default (SD card): no access log, errors only. Every request of
# every device would otherwise be logged.
access_log off;
error_log /dev/stderr error;

# Devices authenticate their websockets with `?token=` (/ws/device,
# /ws/camera) and OAuth callbacks carry `?code=`: if you turn the access
# log on, use this query-free format (`access_log /dev/stdout pnex_noqs;`
# inside a server block), never the default `combined`.
log_format pnex_noqs '$remote_addr - $remote_user [$time_local] '
                     '"$request_method $uri $server_protocol" $status '
                     '$body_bytes_sent "$http_user_agent"';

# Port 80: ACME HTTP-01 challenges (cloud mode), container health probe,
# everything else redirected to https.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    location /.well-known/acme-challenge/ {
        root /var/www/acme;
    }

    location = /nginx-health {
        access_log off;
        allow 127.0.0.1;
        deny all;
        return 200 "ok\n";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    http2 on;
    server_name _;

    ssl_certificate     /pki/current/fullchain.pem;
    ssl_certificate_key /pki/current/privkey.pem;
    # TLS 1.2 stays mandatory: ESP8266 BearSSL has no TLS 1.3. OpenSSL
    # honours the max_fragment_length extension the ESP8266 relies on.
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:pnex_tls:10m;
    ssl_session_timeout 1d;

    # Media uploads (360 captures, firmware artefacts): the backend
    # enforces its own limits.
    client_max_body_size 1g;

    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;

    if ($pnex_alias) {
        return 301 https://${PNEX_PUBLIC_HOST}$request_uri;
    }

    set $pnex_backend pnex-server:5150;

    location /auth/v1/ {
        set $rauthy_upstream rauthy:8080;
        proxy_pass http://$rauthy_upstream;
        # SSE (admin UI events) must not be buffered.
        proxy_buffering off;
        proxy_read_timeout 1h;
    }

    # Device + UI websockets: long-lived, idle between frames.
    location /ws/ {
        # nginx error lines quote the full request (`?token=`): keep only
        # crit here; a failing upstream still answers 502 to the device.
        error_log /dev/stderr crit;
        proxy_pass http://$pnex_backend;
        proxy_buffering off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    location / {
        proxy_pass http://$pnex_backend;
        proxy_read_timeout 300s;
    }
}
